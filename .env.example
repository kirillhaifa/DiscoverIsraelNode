# Firebase Admin SDK — сервисный аккаунт
# Скачать: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Сервер
PORT=8082

# CORS — домен фронтенда
CLIENT_URL=http://localhost:3007

# Доверенные серверы (сборка Next, review-server) шлют x-internal-key: без лимита частоты и с полным списком мест.
# То же значение — в INTERNAL_API_KEY сервиса Next и в tools/place-pipeline/.env
INTERNAL_API_KEY=
# Лимит запросов с одного IP в минуту (по умолчанию 300)
RATE_LIMIT_PER_MINUTE=300
